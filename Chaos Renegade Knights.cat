                <rule id="de00-1cc9-2db8-2901" name="Daemon Knight of Nurgle" hidden="false">
                  <description>Confers Daemon (Aligned with Nurgle) and Hatred (Tzeentch). Gains It Will Not Die!</description>
                </rule>
              </rules>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
              </constraints>
              <costs>
                <cost typeId="points" name="pts" value="75"/>
              </costs>
