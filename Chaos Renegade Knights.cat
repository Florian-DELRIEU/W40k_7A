    <profile typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" id="aa51-04c0-9c9f-ebd4" name="Ion Shield" hidden="false">
      <characteristics>
        <characteristic typeId="21befb24-fc85-4f52-a745-64b2e48f8228" name="Description">At the start of the opponents shooting phase, select the facing of the Ion Shield. The Ion Shield confers a 4+ Invunerable save against that facing until the start of your opponents next shooting phase.</characteristic>
      </characteristics>
    </profile>
